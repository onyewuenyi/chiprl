#!/usr/bin/env bash
# OpenSTA via the chiprl-eda Docker image. Mounts the cwd, repo and temp dir at identical paths so
# absolute paths written by chiprl resolve inside the container. No network.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
TMP="${TMPDIR:-/tmp}"; TMP="${TMP%/}"
exec docker run --rm -i --network none -u "$(id -u):$(id -g)" \
  -v "$PWD:$PWD" -v "$ROOT:$ROOT:ro" -v "$TMP:$TMP" -w "$PWD" \
  "${CHIPRL_EDA_IMAGE:-chiprl-eda}" sta "$@"
